{
  "name": "mfdiy",
  "version": "0.0.0",
  "private": true,
  "description": "No-code builder for custom browser-based MFDs (multi-function displays) driven by live game telemetry.",
  "homepage": "https://mfdiy.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MFDIY/mfdiy.git"
  },
  "bugs": {
    "url": "https://github.com/MFDIY/mfdiy/issues"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "run-p dev:bridge dev:app",
    "dev:app": "npm run dev -w @mfdiy/app",
    "dev:bridge": "npm run dev -w @mfdiy/bridge",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint . --fix",
    "package:windows": "npm run build && npm run package:windows -w @mfdiy/bridge",
    "prepare": "husky",
    "start": "npm run start -w @mfdiy/bridge --",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:stories": "npm run test:stories --workspaces --if-present",
    "test:stories:changed": "npm run test:stories --workspaces --if-present -- --changed --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.3",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.6.9",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
