{
  "name": "@mfdiy/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system for the MFDIY builder interface. Forked from Bonsai (manage.vet); drift is accepted (see docs/decisions/0003).",
  "type": "module",
  "sideEffects": [
    "**/*.css.ts",
    "./src/styles/index.ts"
  ],
  "exports": {
    ".": "./src/styles/index.ts",
    "./components": "./src/components/index.ts",
    "./contexts": "./src/contexts/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:stories": "vitest run --project storybook"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@floating-ui/react": "^0.27.19",
    "@mfdiy/schema": "0.0.0",
    "@vanilla-extract/css": "^1.18.0",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@mfdiy/config": "0.0.0",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-links": "^10.6.9",
    "@storybook/addon-themes": "^10.6.9",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^5.1.4",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^5.1.2",
    "playwright": "^1.65.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.10.0",
    "storybook": "^10.6.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.1.2"
  }
}
